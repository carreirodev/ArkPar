<Window
    x:Class="ArkPar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ArkPar.App"
    Title="ArkPar">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The app draws its own title bar over the Mica backdrop, like Windows 11's own apps. -->
        <StackPanel x:Name="TitleBarArea" Orientation="Horizontal" Spacing="10" Padding="14,0,0,0" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE8FB;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="ArkPar" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- The menu shows names in a wide window, only icons in a narrower one, and hides behind a button in a
             narrow one (Windows' own widths: 1008 and 641), so it never takes half of a narrow window. -->
        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            OpenPaneLength="210"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            AlwaysShowHeader="False"
            SelectionChanged="OnNavigate"
            DisplayModeChanged="OnMenuModeChanged">
            <!-- Each page draws its own rounded layer over the Mica, so the frame's own stays clear. -->
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <!-- Windows leaves room above for a title bar drawn inside the menu; ArkPar's sits above the menu instead. -->
                <Thickness x:Key="NavigationViewMinimalHeaderMargin">-24,4,0,0</Thickness>
            </NavigationView.Resources>
            <!-- An empty header shown only while the menu hides behind its button, so the page starts below the button
                 instead of under it. -->
            <NavigationView.Header>
                <Border />
            </NavigationView.Header>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="CreateItem" Content="Criar">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="VerifyItem" Content="Verificar e reparar">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE73E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsItem" Content="Configurações">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- The pages stay alive, so switching never stops what another is doing. -->
            <Grid>
                <local:CreatePage x:Name="Create" />
                <local:VerifyPage x:Name="Verify" Visibility="Collapsed" />
                <local:SettingsPage x:Name="SettingsView" Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
