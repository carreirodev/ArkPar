<!-- One folder of a folder verification: how it is and, for one set, its detail; for several, those with a problem. -->
<UserControl
    x:Class="ArkPar.App.FolderRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:screens="using:ArkPar.Screens">

    <StackPanel BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="4,8">
        <VisualStateManager.VisualStateGroups>
            <!-- The folder's group (HealthGroup), or Pending while its sets wait. -->
            <VisualStateGroup x:Name="Health">
                <VisualState x:Name="Pending" />
                <VisualState x:Name="Complete">
                    <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Repairable">
                    <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unrepairable">
                    <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unverified">
                    <VisualState.Setters>
                        <Setter Target="Dot.Fill" Value="{ThemeResource SystemFillColorAttentionBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{ThemeResource ControlStrongFillColorDisabledBrush}" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="NameText" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="HealthLine" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="SetsText" Style="{StaticResource SecondaryCaption}" VerticalAlignment="Center" />
                <Button x:Name="OpenButton" Content="Ver detalhes" Click="OnOpen" />
                <ToggleButton x:Name="ListButton" Click="OnToggleList" />
            </StackPanel>
        </Grid>

        <!-- A folder with several sets: all of them before they are verified, then those with a problem, each opening its detail. -->
        <ItemsRepeater x:Name="ProblemList" Visibility="Collapsed" Margin="32,6,0,0">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="screens:CheckedSet">
                    <Grid ColumnSpacing="10" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind RecoveryFile}" />
                            <TextBlock Text="{x:Bind HealthText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Ver detalhes" Click="OnOpenSet" VerticalAlignment="Center" Visibility="{x:Bind HasResult, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
