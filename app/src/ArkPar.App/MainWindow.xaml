<Window
    x:Class="ArkPar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ArkPar.App"
    Title="ArkPar">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The app draws its own title bar over the Mica backdrop, like Windows 11's own apps. -->
        <StackPanel x:Name="TitleBarArea" Orientation="Horizontal" Spacing="10" Padding="14,0,0,0" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE8FB;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="ArkPar" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="210"
            IsPaneToggleButtonVisible="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="OnNavigate">
            <!-- Each page draws its own rounded layer over the Mica, so the frame's own stays clear. -->
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="CreateItem" Content="Criar">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="VerifyItem" Content="Verificar e reparar">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE73E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Both pages stay alive, so switching never stops what the other is doing. -->
            <Grid>
                <local:CreatePage x:Name="Create" />
                <local:VerifyPage x:Name="Verify" Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
