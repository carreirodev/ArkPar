<!-- The Create screen. What it shows comes from ArkPar.Screens.CreateScreen; this file only lays it out. -->
<UserControl
    x:Class="ArkPar.App.CreatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ArkPar.App"
    xmlns:screens="using:ArkPar.Screens">

    <!-- See VerifyPage.xaml for why functions over values that can be null carry a FallbackValue. -->

    <!-- The whole page takes files and folders dragged from Explorer, not only the dashed area. -->
    <Border
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1,1,0,0"
        CornerRadius="8,0,0,0"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop">
        <ScrollViewer x:Name="Scroller">
            <StackPanel Spacing="18" Padding="28,24" MaxWidth="1100">

                <!-- Header: where the set goes, and where the screen is. -->
                <StackPanel Spacing="2">
                    <TextBlock
                        Text="{x:Bind Screen.Destination, Mode=OneWay, TargetNullValue='Novo arquivo de recuperação'}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind Screen.Heading, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                </StackPanel>

                <!-- While the engine works. -->
                <Border Style="{StaticResource Card}" Visibility="{x:Bind Screen.IsRunning, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="{x:Bind Screen.SetProgressText, Mode=OneWay}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind local:Ui.VisibleIfText(Screen.SetProgressText), Mode=OneWay, FallbackValue=Collapsed}" />
                        <TextBlock Text="{x:Bind Screen.ActivityText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <ProgressBar
                            Maximum="100"
                            Value="{x:Bind local:Ui.PercentOf(Screen.Percent), Mode=OneWay}"
                            IsIndeterminate="{x:Bind Screen.IsPercentUnknown, Mode=OneWay}"
                            ShowPaused="{x:Bind Screen.IsPaused, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="{x:Bind Screen.PauseText, Mode=OneWay}" Click="OnTogglePause" IsEnabled="{x:Bind Screen.CanControl, Mode=OneWay}" />
                            <Button Content="Cancelar" Click="OnCancel" IsEnabled="{x:Bind Screen.CanCancel, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The result's headline, at the top where the page scrolls to when Criar is clicked. -->
                <InfoBar
                    IsOpen="{x:Bind Screen.HasBanner, Mode=OneWay}"
                    Visibility="{x:Bind Screen.HasBanner, Mode=OneWay}"
                    IsClosable="False"
                    Severity="{x:Bind local:Ui.SeverityOf(Screen.Banner), Mode=OneWay}"
                    Title="{x:Bind Screen.Banner.Title, Mode=OneWay, FallbackValue=''}"
                    Message="{x:Bind Screen.Banner.Detail, Mode=OneWay, FallbackValue=''}" />

                <!-- Choosing what to protect: drop it here, or pick it on disk. -->
                <Grid Visibility="{x:Bind Screen.CanChoose, Mode=OneWay}" MinHeight="64">
                    <Rectangle
                        Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                        StrokeThickness="1.5"
                        StrokeDashArray="4,3"
                        RadiusX="7"
                        RadiusY="7" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16,12">
                        <TextBlock Text="Arraste arquivos ou pastas para cá, ou escolha no disco:" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton Content="arquivos" Click="OnChooseFiles" />
                        <TextBlock Text="ou" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton Content="uma pasta" Click="OnChooseFolder" />
                    </StackPanel>
                </Grid>

                <!-- Reading a big folder takes a moment. -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10"
                    Visibility="{x:Bind Screen.IsReading, Mode=OneWay}">
                    <ProgressRing IsActive="True" Width="18" Height="18" />
                    <TextBlock Text="Lendo os arquivos escolhidos…" VerticalAlignment="Center" />
                </StackPanel>

                <InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Warning"
                    Message="{x:Bind Screen.SelectionProblem, Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.VisibleIfText(Screen.SelectionProblem), Mode=OneWay, FallbackValue=Collapsed}" />
                <InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Message="{x:Bind Screen.SelectionWarning, Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.VisibleIfText(Screen.SelectionWarning), Mode=OneWay, FallbackValue=Collapsed}" />

                <!-- How what was chosen is split into sets: picked each time, each mode explained on the same example. -->
                <Border Style="{StaticResource Card}" Visibility="{x:Bind Screen.HasSelection, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Como dividir em conjuntos" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <!-- Filled in code (CreatePage), from the screen's own list. -->
                        <RadioButtons
                            x:Name="ModeButtons"
                            MaxColumns="2"
                            IsEnabled="{x:Bind Screen.CanChoose, Mode=OneWay}"
                            SelectionChanged="OnModeChanged"
                            AutomationProperties.Name="Como dividir em conjuntos">
                            <RadioButtons.ItemTemplate>
                                <DataTemplate x:DataType="screens:ModeChoice">
                                    <!-- A width to wrap at, so two options fit side by side when the window is wide. -->
                                    <StackPanel Spacing="2" Margin="0,0,12,8" MaxWidth="420">
                                        <TextBlock Text="{x:Bind Title}" />
                                        <TextBlock Text="{x:Bind Explanation}" Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButtons.ItemTemplate>
                        </RadioButtons>
                    </StackPanel>
                </Border>

                <!-- What was chosen, beside how much redundancy every set gets. -->
                <Grid ColumnSpacing="16" Visibility="{x:Bind Screen.HasSelection, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Text="Arquivos incluídos" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Screen.Summary, Mode=OneWay}" Style="{StaticResource SecondaryCaption}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Grid>
                            <!-- Filled in code (CreatePage.ShowTree): each folder's contents are added when it opens. -->
                            <TreeView
                                x:Name="FilesTree"
                                SelectionMode="None"
                                MaxHeight="360"
                                CanDragItems="False"
                                CanReorderItems="False">
                                <TreeView.ItemTemplate>
                                    <DataTemplate x:DataType="TreeViewNode">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind local:Ui.IconOf(((screens:SelectionNode)Content).IsFolder)}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind ((screens:SelectionNode)Content).Name}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind ((screens:SelectionNode)Content).Name}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind ((screens:SelectionNode)Content).Meta}"
                                                Style="{StaticResource SecondaryCaption}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0" />
                                        </Grid>
                                    </DataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <Button Content="Limpar seleção" Click="OnClear" IsEnabled="{x:Bind Screen.CanChoose, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock Text="Redundância" />
                                <TextBlock Text="{x:Bind Screen.RedundancyText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider
                                x:Name="RedundancySlider"
                                StepFrequency="1"
                                IsEnabled="{x:Bind Screen.CanChoose, Mode=OneWay}"
                                ValueChanged="OnRedundancyChanged"
                                AutomationProperties.Name="Redundância" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Ocupa" Style="{StaticResource SecondaryCaption}" />
                                    <TextBlock Text="{x:Bind Screen.SpaceText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Repara até" Style="{StaticResource SecondaryCaption}" />
                                    <TextBlock Text="{x:Bind Screen.RepairableText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Salvar em" Style="{StaticResource SecondaryCaption}" />
                                    <TextBlock
                                        Text="{x:Bind Screen.SaveIn, Mode=OneWay}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Screen.Selection.BaseDirectory, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind Screen.IsEstimating, Mode=OneWay}">
                                <ProgressRing IsActive="True" Width="14" Height="14" />
                                <TextBlock Text="{x:Bind Screen.EstimatingText, Mode=OneWay}" Style="{StaticResource SecondaryCaption}" />
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind Screen.EstimateProblem, Mode=OneWay}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind local:Ui.VisibleIfText(Screen.EstimateProblem), Mode=OneWay, FallbackValue=Collapsed}" />
                            <TextBlock
                                Text="Repara até esse tanto se o dano estiver concentrado. Dano espalhado por muitos arquivos repara menos."
                                Style="{StaticResource SecondaryCaption}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- The sets the create will make and where each goes, before Criar. A list, as per file can mean thousands. -->
                <Border Style="{StaticResource Card}" Visibility="{x:Bind Screen.HasSets, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind Screen.SetsTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <InfoBar
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Warning"
                            Message="{x:Bind Screen.ParFilesWarning, Mode=OneWay}"
                            Visibility="{x:Bind local:Ui.VisibleIfText(Screen.ParFilesWarning), Mode=OneWay, FallbackValue=Collapsed}" />
                        <ListView
                            ItemsSource="{x:Bind Screen.Sets, Mode=OneWay}"
                            SelectionMode="None"
                            MaxHeight="240"
                            AutomationProperties.Name="Conjuntos que serão criados">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="screens:PlannedSet">
                                    <Grid ColumnSpacing="12" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind RecoveryFile}" />
                                            <TextBlock Text="{x:Bind Where}" Style="{StaticResource SecondaryCaption}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind BaseDirectory}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Meta}" Style="{StaticResource SecondaryCaption}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Advanced settings, closed: each one starts on Automático, chosen by the engine. -->
                <Expander
                    Header="Avançado"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Visibility="{x:Bind Screen.HasSelection, Mode=OneWay}"
                    IsEnabled="{x:Bind Screen.CanChoose, Mode=OneWay}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="BlockSizeBox"
                                Header="Tamanho do bloco"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnBlockSizeChanged" />
                            <NumberBox
                                x:Name="RecoveryFileCountBox"
                                Grid.Column="1"
                                Header="Número de arquivos de recuperação"
                                PlaceholderText="Automático"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnRecoveryFileCountChanged" />
                            <ComboBox
                                x:Name="MemoryBox"
                                Grid.Column="2"
                                Header="Limite de memória"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnMemoryChanged" />
                        </Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Screen.BlocksText, Mode=OneWay}" Style="{StaticResource SecondaryCaption}" />
                            <TextBlock Text="{x:Bind Screen.RecoveryFilesText, Mode=OneWay}" Style="{StaticResource SecondaryCaption}" />
                            <TextBlock
                                Text="Blocos menores consertam danos pequenos com menos espaço, mas a criação fica mais lenta. Deixe em branco o número de arquivos para o motor escolher."
                                Style="{StaticResource SecondaryCaption}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Create (or replace the set of the same name already there). -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Visibility="{x:Bind Screen.HasSelection, Mode=OneWay}">
                    <TextBlock
                        Text="{x:Bind Screen.ReplaceWarning, Mode=OneWay}"
                        Style="{StaticResource SecondaryCaption}"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind local:Ui.VisibleIfText(Screen.ReplaceWarning), Mode=OneWay, FallbackValue=Collapsed}" />
                    <Button
                        Content="{x:Bind Screen.CreateText, Mode=OneWay}"
                        Click="OnCreate"
                        IsEnabled="{x:Bind Screen.CanCreate, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <!-- What went wrong, in the engine's words, when something failed. -->
                <Expander
                    Header="Detalhes técnicos"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Visibility="{x:Bind local:Ui.VisibleIfText(Screen.Details), Mode=OneWay, FallbackValue=Collapsed}">
                    <TextBlock
                        Text="{x:Bind Screen.Details, Mode=OneWay}"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
