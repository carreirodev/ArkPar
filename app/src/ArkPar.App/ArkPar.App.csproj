<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ArkPar.App</RootNamespace>
    <AssemblyName>ArkPar</AssemblyName>
    <!-- The version Explorer shows for ArkPar.exe; the GitHub release carries the same number (v1.0.0). -->
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embedded in ArkPar.exe: Explorer shows it for the exe and, through DefaultIcon, for .par2 files. -->
    <ApplicationIcon>Assets\ArkPar.ico</ApplicationIcon>

    <!-- The engine is 64-bit only, and so is the GUI. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged (no MSIX). Development builds are framework-dependent: they use the
         Windows App SDK runtime installed on this PC, found at startup by the SDK's
         bootstrapper. The package (app/build-package.ps1) carries both runtimes inside (ADR-0002). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!-- Only the Windows App SDK parts the app uses, not the full Microsoft.WindowsAppSDK package,
       whose AI, ML, Search and Widgets parts made the zip 25 MB bigger, and the unzipped folder
       62 MB bigger (WPC-403). WinUI draws the screens, Foundation has the file pickers, and Runtime
       carries the version info the bootstrapper needs in development builds. All on the same version. -->
  <PropertyGroup>
    <WindowsAppSdkVersion>2.6.5</WindowsAppSdkVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="$(WindowsAppSdkVersion)" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="$(WindowsAppSdkVersion)" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="$(WindowsAppSdkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArkPar.Engine\ArkPar.Engine.csproj" />
    <ProjectReference Include="..\ArkPar.Screens\ArkPar.Screens.csproj" />
  </ItemGroup>

  <!-- The icon is also a file next to the app, since the window and the notifications take their icon from a file
       (App.IconPath). Drawn by app/build-icon.ps1 from the two ArkPar-*.svg beside it, which WinUI would
       also ship, since it takes everything under Assets as content: only the WPC Solutions logos at the end of
       Settings ship as SVG (made by app/build-logo.ps1). -->
  <ItemGroup>
    <Content Remove="Assets\*.svg" />
    <Content Include="Assets\wpc-logo-*.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Assets\ArkPar.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The engine ships next to the app, where EngineRun.DefaultEnginePath looks for it.
       It is built by app/build-engine.ps1 (a C++ project), not by dotnet. -->
  <ItemGroup Condition="Exists('$(ArkParEngineDir)par2j64.exe')">
    <None Include="$(ArkParEngineDir)par2j64.exe" Link="engine\par2j64.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
