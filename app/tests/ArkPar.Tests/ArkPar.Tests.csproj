<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.5.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ArkPar.Engine\ArkPar.Engine.csproj" />
    <ProjectReference Include="..\..\src\ArkPar.Screens\ArkPar.Screens.csproj" />
  </ItemGroup>

  <!-- Real engine output and JSON results, captured byte for byte (see Engine/Fixtures/README.md). -->
  <ItemGroup>
    <None Include="Engine\Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The app's icon, checked by App/AppIconTests.cs. -->
  <ItemGroup>
    <None Include="..\..\src\ArkPar.App\Assets\ArkPar.ico" Link="Assets\ArkPar.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The engine is built by app/build-engine.ps1, not by dotnet (it is a C++ project).
       When it exists, copy it next to the tests; EngineProcess fails with a clear message
       when it does not. -->
  <ItemGroup Condition="Exists('$(ArkParEngineDir)par2j64.exe')">
    <None Include="$(ArkParEngineDir)par2j64.exe" Link="engine\par2j64.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
