<!-- The Settings screen. What it shows comes from ArkPar.Screens.SettingsScreen; this file only lays it out. -->
<UserControl
    x:Class="ArkPar.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ArkPar.App">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- The WPC Solutions logo follows Windows' light or dark mode as it changes. "Default" serves dark mode
                 and high contrast, which fall back to it. The SVGs are made by app/build-logo.ps1. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SvgImageSource x:Key="WpcLogo" UriSource="ms-appx:///Assets/wpc-logo-dark-background.svg" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SvgImageSource x:Key="WpcLogo" UriSource="ms-appx:///Assets/wpc-logo-light-background.svg" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1,1,0,0"
        CornerRadius="8,0,0,0">
        <ScrollViewer>
            <StackPanel Padding="28,24" MaxWidth="1100" Spacing="8">
                <TextBlock Text="Configurações" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,10" />

                <InfoBar
                    IsOpen="{x:Bind Screen.HasBanner, Mode=OneWay}"
                    IsClosable="False"
                    Severity="{x:Bind local:Ui.SeverityOf(Screen.Banner), Mode=OneWay}"
                    Title="{x:Bind Screen.Banner.Title, Mode=OneWay, FallbackValue=''}"
                    Message="{x:Bind Screen.Banner.Detail, Mode=OneWay, FallbackValue=''}" />

                <TextBlock Text="Desempenho" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Usar a placa de vídeo (GPU)" TextWrapping="Wrap" />
                            <TextBlock
                                Text="Criar e reparar ficam mais rápidos num PC com placa de vídeo. Sem uma, o ArkPar usa só o processador."
                                Style="{StaticResource SecondaryCaption}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            AutomationProperties.Name="Usar a placa de vídeo (GPU)"
                            IsOn="{x:Bind Screen.UseGpu, Mode=TwoWay}"
                            OnContent="Ligado"
                            OffContent="Desligado"
                            MinWidth="0" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Núcleos do processador" TextWrapping="Wrap" />
                            <TextBlock
                                Text="Automático usa todos os núcleos físicos do processador. Menos núcleos deixam o PC mais livre enquanto o ArkPar trabalha, mas a tarefa demora mais."
                                Style="{StaticResource SecondaryCaption}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            x:Name="ThreadsBox"
                            AutomationProperties.Name="Núcleos do processador"
                            Grid.Column="1"
                            MinWidth="150"
                            VerticalAlignment="Center"
                            ItemsSource="{x:Bind Screen.ThreadChoices}"
                            SelectedItem="{x:Bind Screen.Threads, Mode=OneWay}"
                            SelectionChanged="OnThreadsChanged" />
                    </Grid>
                </Border>

                <TextBlock Text="Arquivos .par2" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Abrir arquivos .par2 com o ArkPar" TextWrapping="Wrap" />
                                <TextBlock
                                    Text="Dois cliques num arquivo .par2 no Explorer abrem o ArkPar e verificam o conjunto."
                                    Style="{StaticResource SecondaryCaption}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                AutomationProperties.Name="Abrir arquivos .par2 com o ArkPar"
                                IsOn="{x:Bind Screen.OpenPar2Files, Mode=TwoWay}"
                                OnContent="Ligado"
                                OffContent="Desligado"
                                MinWidth="0" />
                        </Grid>
                        <InfoBar
                            IsOpen="{x:Bind Screen.AnotherAppChosen, Mode=OneWay}"
                            Visibility="{x:Bind Screen.AnotherAppChosen, Mode=OneWay}"
                            IsClosable="False"
                            Severity="Warning"
                            Title="O Windows ainda abre os arquivos .par2 com outro programa."
                            Message="Para trocar: clique com o botão direito num arquivo .par2, escolha Abrir com › Escolher outro aplicativo, marque ArkPar e clique em Sempre." />
                    </StackPanel>
                </Border>

                <TextBlock Text="As mudanças valem a partir do próximo conjunto criado, verificado ou reparado." TextWrapping="Wrap" Style="{StaticResource SecondaryCaption}" Margin="0,8,0,0" />

                <!-- What went wrong, in technical terms, when something failed. -->
                <Expander
                    Header="Detalhes técnicos"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Visibility="{x:Bind local:Ui.VisibleIfText(Screen.Details), Mode=OneWay, FallbackValue=Collapsed}">
                    <TextBlock
                        Text="{x:Bind Screen.Details, Mode=OneWay}"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                </Expander>

                <!-- Last on the screen, after the technical details too, where Windows apps put "About". -->
                <TextBlock Text="Sobre" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8" HorizontalAlignment="Left">
                        <!-- The negative margin keeps the logo in line with the text, with room for the focus border. -->
                        <HyperlinkButton
                            NavigateUri="https://wpcsolutions.com.br"
                            AutomationProperties.Name="WPC Solutions, abrir wpcsolutions.com.br"
                            ToolTipService.ToolTip="wpcsolutions.com.br"
                            Padding="4"
                            Margin="-4">
                            <!-- 160 px wide at most; narrower when the window leaves less room. -->
                            <Image Source="{ThemeResource WpcLogo}" MaxWidth="160" Stretch="Uniform" />
                        </HyperlinkButton>
                        <TextBlock Text="Desenvolvido por WPC Solutions" Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
